<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurações do GlowTTS"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Voz padrão"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgVoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbPtBrFrancisca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Português (Brasil) - Francisca (pt-BR-FranciscaNeural)" />

            <RadioButton
                android:id="@+id/rbPtBrAntonio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Português (Brasil) - Antônio (pt-BR-AntonioNeural)" />

            <RadioButton
                android:id="@+id/rbPtPtRaquel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Português (Portugal) - Raquel (pt-PT-RaquelNeural)" />

            <RadioButton
                android:id="@+id/rbEnUsJenny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inglês (EUA) - Jenny (en-US-JennyNeural)" />

            <RadioButton
                android:id="@+id/rbEsEsElvira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Espanhol (Espanha) - Elvira (es-ES-ElviraNeural)" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvRateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Velocidade extra: 0%"
            android:textSize="15sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/tvPitchLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tom extra: 0Hz"
            android:textSize="15sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Salvar configurações" />

        <TextView
            android:id="@+id/tvSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
