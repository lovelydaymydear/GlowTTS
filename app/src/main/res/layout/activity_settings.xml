<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glow_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configurações de voz"
                android:textColor="@color/glow_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Escolha um idioma e uma ou mais vozes."
                android:textColor="@color/glow_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idioma"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spLanguages"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/glow_surface_elevated"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Filtrar voz por nome"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVoiceSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/glow_surface_elevated"
                android:hint="Ex.: Francisca, Jenny, Raquel..."
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/glow_text_primary"
                android:textColorHint="@color/glow_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Vozes do idioma selecionado"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spVoices"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/glow_surface_elevated"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddVoiceToList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/glow_surface_elevated"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="+ Adicionar voz"
                    android:textColor="@color/glow_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnClearVoiceList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/glow_surface_elevated"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="Usar só 1 voz"
                    android:textColor="@color/glow_pink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveVoicesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Vozes em rotação: pt-BR-FranciscaNeural"
                android:textColor="@color/glow_text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReloadVoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/glow_surface_elevated"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="Atualizar lista de vozes"
                android:textColor="@color/glow_text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voz para diálogos"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogueVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Diálogo: DESATIVADO (pt-BR-AntonioNeural)"
                android:textColor="@color/glow_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSetDialogueVoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/glow_surface_elevated"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="Definir voz diálogo"
                    android:textColor="@color/glow_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleDialogueVoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/glow_surface_elevated"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="Ativar / Desativar"
                    android:textColor="@color/glow_pink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvRateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Velocidade extra: +0%"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100" />

            <TextView
                android:id="@+id/tvPitchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tom extra: +0Hz"
                android:textColor="@color/glow_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glow_button"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="50dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Salvar configurações"
                android:textColor="@color/glow_text_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
